<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="neon_bg">#FF07060F</color>

    <style name="Theme.Neon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/neon_bg</item>
        <item name="android:statusBarColor">@color/neon_bg</item>
        <item name="android:navigationBarColor">@color/neon_bg</item>
    </style>

    <style name="Theme.Neon.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Neon.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
